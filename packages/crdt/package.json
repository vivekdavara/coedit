{
  "name": "@coedit/crdt",
  "version": "1.0.0",
  "private": true,
  "description": "A sequence CRDT (RGA) for plain text, and the sync protocol's messages",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "harness-stats": "node --disable-warning=ExperimentalWarning scripts/harness_stats.ts",
    "bench-codec": "node --disable-warning=ExperimentalWarning scripts/bench_codec.ts",
    "deep-convergence": "node --disable-warning=ExperimentalWarning scripts/deep_convergence.ts",
    "worst-delete": "node --expose-gc --disable-warning=ExperimentalWarning scripts/worst_delete.ts",
    "editing": "node --expose-gc --disable-warning=ExperimentalWarning scripts/editing.ts"
  }
}
